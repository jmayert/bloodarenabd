# Database (Azure Database for MySQL — bloodarenabd)
DATABASE_URL="mysql://user:password@eduall2005pass.mysql.database.azure.com:3306/bloodarenabd?sslaccept=accept_invalid_certs&sslmode=require"
DIRECT_DATABASE_URL="mysql://user:password@eduall2005pass.mysql.database.azure.com:3306/bloodarenabd?sslaccept=accept_invalid_certs&sslmode=require"

# Firebase Admin SDK (server-side only - NEVER expose these)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Firebase Web config (public by design, injected into frontend)
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID_PUBLIC=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Session
JWT_SECRET=
SESSION_TTL_DAYS=365

# SMS gateway (OneCodeSoft)
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=

# Telegram bot service
TELEGRAM_BOT_URL=
TELEGRAM_BOT_SECRET=
TELEGRAM_BOT_USERNAME=

# Email (reports)
REPORT_EMAIL_TO=
RESEND_API_KEY=

# Upload storage (Vercel Blob)
BLOB_READ_WRITE_TOKEN=

# Request cleanup: delete requests older than N days (default 3)
AUTO_DELETE_DAYS=3

# Brand colors (frontend theming)
COLOR_BG_MAIN=#f5f6fa
COLOR_PRIMARY=#c0392b
COLOR_PRIMARY_HOVER=#a93226
