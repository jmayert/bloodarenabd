{
  "name": "blood-arena-node",
  "version": "1.0.0",
  "private": true,
  "description": "Blood Arena BD - Node.js backend (migrated from PHP)",
  "main": "dist/api/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn src/local.ts",
    "build": "tsc -p tsconfig.json && prisma generate",
    "start": "node dist/src/local.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "ts-node scripts/seed.ts",
    "db:import": "ts-node scripts/import.ts"
  },
  "prisma": {
    "seed": "ts-node scripts/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@vercel/blob": "^2.8.0",
    "mysql2": "^3.11.4",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "firebase-admin": "^12.7.0",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.33.5",
    "undici": "^8.10.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.9.0",
    "dotenv": "^16.4.5",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "engines": {
    "node": ">=20"
  }
}
